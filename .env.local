# Database configuration
GRAMPSWEB_DATABASE_URL=postgresql://gramps:gramps_password@localhost:5432/gramps_web
GRAMPSWEB_USER_DB_URI=postgresql://gramps:gramps_password@localhost:5432/gramps_web

# Flask configuration
GRAMPSWEB_SECRET_KEY=your-development-secret-key-change-in-production
GRAMPSWEB_TREE=gramps_dev_tree
GRAMPSWEB_LOG_LEVEL=DEBUG
FLASK_ENV=development
FLASK_DEBUG=true

# API configuration
GRAMPSWEB_BASE_URL=http://localhost:5555
GRAMPSWEB_CORS_ORIGINS=http://localhost:8001
GRAMPSWEB_FRONTEND_URL=http://localhost:8001
SEARCH_INDEXER=whoosh

# OIDC Configuration (enabled for testing)
GRAMPSWEB_OIDC_ENABLED=true
GRAMPSWEB_OIDC_DISABLE_LOCAL_AUTH=true
GRAMPSWEB_OIDC_AUTO_REDIRECT=false
