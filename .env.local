# Database configuration
GRAMPSWEB_DATABASE_URL=sqlite:///home/alex/.local/src/gramps-oidc-testing/gramps_web.db
GRAMPSWEB_USER_DB_URI=sqlite:///home/alex/.local/src/gramps-oidc-testing/gramps_users.db

# Flask configuration
GRAMPSWEB_SECRET_KEY=your-development-secret-key-change-in-production
GRAMPSWEB_TREE=gramps_dev_tree
GRAMPSWEB_LOG_LEVEL=DEBUG
FLASK_ENV=development
FLASK_DEBUG=true

# API configuration
GRAMPSWEB_CORS_ORIGINS=http://localhost:8001
GRAMPSWEB_FRONTEND_URL=http://localhost:8001
SEARCH_INDEXER=whoosh

# OIDC Configuration (enabled for testing)
GRAMPSWEB_OIDC_ENABLED=true
GRAMPSWEB_OIDC_ISSUER=http://localhost:8080/realms/gramps
GRAMPSWEB_OIDC_CLIENT_ID=gramps-web
GRAMPSWEB_OIDC_CLIENT_SECRET=jWsdTtEb0fbLJYKeQYnz7sUDavTKdNSF
GRAMPSWEB_OIDC_REDIRECT_URI=http://localhost:5555/api/oidc/callback/
GRAMPSWEB_OIDC_DISABLE_LOCAL_AUTH=false
GRAMPSWEB_OIDC_AUTO_REDIRECT=false
GRAMPSWEB_OIDC_SCOPES="openid email profile"
GRAMPSWEB_OIDC_ROLE_CLAIM=groups
GRAMPSWEB_OIDC_USERNAME_CLAIM=preferred_username
GRAMPSWEB_OIDC_OPENID_CONFIG_URL=http://localhost:8080/realms/gramps/.well-known/openid-configuration

# OIDC Role Mapping
GRAMPSWEB_OIDC_GROUP_ADMIN=gramps-admin
GRAMPSWEB_OIDC_GROUP_OWNER=gramps-owner
GRAMPSWEB_OIDC_GROUP_EDITOR=gramps-editor
GRAMPSWEB_OIDC_GROUP_CONTRIBUTOR=gramps-contributor
GRAMPSWEB_OIDC_GROUP_MEMBER=gramps-member
GRAMPSWEB_OIDC_GROUP_GUEST=gramps-guest

# Celery (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
